# Supabase do projeto (local: valores de `npm run db:status`; real: Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rótulo mostrado na barra superior (ex.: Desenvolvimento, Homologação). Vazio em produção.
NEXT_PUBLIC_ENVIRONMENT_LABEL=Desenvolvimento

# Só para scripts administrativos e testes. Nunca no navegador, nunca em src/.
SUPABASE_SERVICE_ROLE_KEY=
