# Modelo de .env.local (o arquivo real é ignorado pelo git).
# Local: valores de `npm run db:status`. Projeto real: Settings > API e Settings > Database.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rótulo mostrado na barra superior (ex.: Desenvolvimento, Homologação). Vazio em produção.
NEXT_PUBLIC_ENVIRONMENT_LABEL=Desenvolvimento

# IA do diretor (opcional). Só no servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Chave de serviço do Supabase (Settings > API). Só no servidor, nunca NEXT_PUBLIC_. Usada pelos
# scripts administrativos (npm run bootstrap) e, na aplicação, só para gerar o link de nova senha
# de quem pediu em "Esqueci minha senha" (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do "Esqueci minha senha": caixa de suporte da Fortes Pay, por SMTP. Só no servidor.
# Sem SMTP_HOST e SMTP_FROM a tela não envia e-mail e explica o caminho pelo diretor.
# Local: SMTP_HOST=127.0.0.1 e SMTP_PORT=54345 (Mailpit do Supabase local), sem usuário nem senha.
SMTP_HOST=
# 587 (padrão, STARTTLS) ou 465 (TLS direto).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente que a pessoa vê, ex.: "Fortes Pay <suporte@fortespay.com.br>"
SMTP_FROM=

# Só para `npm run db:push` no projeto real: pooler em modo sessão (porta 5432), senha em percent-encoding.
# Ex.: postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Os testes (npm run test:db, test:e2e) não leem este arquivo: usam .env.test, sempre o Supabase local.
