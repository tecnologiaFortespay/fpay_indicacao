# Modelo de .env.local (o arquivo real é ignorado pelo git).
# Local: valores de `npm run db:status`. Projeto real: Settings > API e Settings > Database.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rótulo mostrado na barra superior (ex.: Desenvolvimento, Homologação). Vazio em produção.
NEXT_PUBLIC_ENVIRONMENT_LABEL=Desenvolvimento

# IA do diretor (opcional). Só no servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Só para scripts administrativos (npm run bootstrap). Nunca no navegador, nunca em src/.
SUPABASE_SERVICE_ROLE_KEY=

# Só para `npm run db:push` no projeto real: pooler em modo sessão (porta 5432), senha em percent-encoding.
# Ex.: postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Os testes (npm run test:db, test:e2e) não leem este arquivo: usam .env.test, sempre o Supabase local.
