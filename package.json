{
  "name": "fpay_indicacao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/local.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:clean": "node scripts/db-clean.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/types.ts",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "bootstrap:local": "node --env-file=.env.test scripts/bootstrap.mjs",
    "reset-link": "node --env-file=.env.local scripts/reset-link.mjs",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "geist": "^1.8.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.2",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
